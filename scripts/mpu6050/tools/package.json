{
  "name": "mpu6050-dashboard-model-tools",
  "version": "1.1.0",
  "private": true,
  "description": "Convert the project's STEP model and compress the browser GLB",
  "scripts": {
    "convert": "node step_to_glb.js \"../esp32-3D模型.step\" \"../assets/esp32.glb\"",
    "optimize": "node optimize_glb.mjs \"../assets/esp32.glb\" \"../assets/esp32.glb\"",
    "build-model": "npm run convert && npm run optimize"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^0.20.0",
    "occt-import-js": "0.0.23"
  }
}
